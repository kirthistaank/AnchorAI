# Server Configuration
DEBUG=true
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/wellness

# Neo4j (for CBT knowledge base)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password

# ChromaDB (local vector store)
CHROMADB_PATH=./data/chromadb

# LLM Configuration
ANTHROPIC_API_KEY=your_anthropic_key_here
OLLAMA_BASE_URL=http://localhost:11434

# Models
PRIMARY_MODEL=claude-3-5-sonnet-20241022
CLASSIFICATION_MODEL=claude-3-5-haiku-20241022
FALLBACK_MODEL=ollama/mistral

# Budget
MONTHLY_BUDGET_USD=10.00

# Guardrails
GUARDRAILS_ENABLED=true
PII_DETECTION_ENABLED=true
PROMPT_INJECTION_DETECTION_ENABLED=true
CRISIS_DETECTION_ENABLED=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Agent
MAX_AGENT_ITERATIONS=5
AGENT_TIMEOUT_SECONDS=30
RATE_LIMIT_RPM=10
